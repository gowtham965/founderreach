# Copy to .env (run.sh does this for you and fills SECRET_KEY)

BASE_URL=http://localhost:8000
SECRET_KEY=
DATABASE_URL=sqlite:///./founderreach.db
# Postgres for production: postgresql+psycopg://user:pass@host/db  (pip install psycopg[binary])

# --- LLM: anthropic | ollama | fake ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Going local later:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# --- Sign in with Google (optional; name + email only, no Gmail access) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: better founder emails ---
HUNTER_API_KEY=
# GitHub token with no scopes: raises the API limit for reading public commits (60 → 5,000/hour)
GITHUB_TOKEN=

# --- AI cost levers (README → "AI costs") ---
# Fast model for extraction and startup scoring; set equal to ANTHROPIC_MODEL to undo.
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Thinking effort per kind of work: low | medium | high | xhigh | max (empty = model default)
# EFFORT_CHAT=medium
# EFFORT_EXTRACT=low
# EFFORT_DRAFT=

# --- Humanize pass on every draft: always | when_tells | off ---
HUMANIZE_MODE=always

# --- Guardrails ---
MAX_DRAFTS_PER_DAY=15
FOLLOWUP_DAYS=3,7
DAILY_MATCHES=5
DIGEST_HOUR_IST=8

# WhatsApp bot (Meta WhatsApp Cloud API): developers.facebook.com → your app → WhatsApp → API Setup.
# Webhook URL: <BASE_URL>/api/whatsapp/webhook  (use a tunnel such as cloudflared while on your Mac)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_NUMBER=

# Sign-up confirmation emails, sent from a Gmail account with an app password
# (myaccount.google.com/apppasswords; needs 2-step verification). Empty = link printed in the server log.
SMTP_USER=
SMTP_PASSWORD=
